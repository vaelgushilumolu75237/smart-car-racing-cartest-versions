      "type": "stlinkgdbtarget",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CarTest: Build Debug",
      "serverInterface": "SWD",
      "serverInterfaceFrequency": "4000",
      "serverReset": "Software system reset",
