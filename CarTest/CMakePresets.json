{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CARTEST_ENABLE_FOLLOW_SPEED_PI": "OFF",
        "CARTEST_ENABLE_FOLLOW_TURN": "OFF"
      }
    },
    {
      "name": "Debug",
      "displayName": "Debug - motors and servo PWM off",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CARTEST_ENABLE_BENCH": "OFF",
        "CARTEST_ENABLE_FOLLOW": "OFF",
        "CARTEST_ENABLE_STEERING": "OFF",
        "CARTEST_HARDWARE_ACCEPTED": "OFF",
        "CARTEST_RUNTIME_LOG_ENABLED": "ON",
        "CARTEST_FOLLOW_DIFF_PERMILLE": "0"
      }
    },
    {
      "name": "DebugSteering",
      "displayName": "DebugSteering - motors off, vision auto-steering",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CARTEST_ENABLE_BENCH": "OFF",
        "CARTEST_ENABLE_FOLLOW": "OFF",
        "CARTEST_ENABLE_STEERING": "ON",
        "CARTEST_HARDWARE_ACCEPTED": "OFF",
        "CARTEST_RUNTIME_LOG_ENABLED": "ON",
        "CARTEST_FOLLOW_DIFF_PERMILLE": "0"
      }
    },
    {
      "name": "DebugBench",
      "displayName": "DebugBench - motor output locked pending hardware acceptance",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CARTEST_ENABLE_BENCH": "ON",
        "CARTEST_ENABLE_FOLLOW": "OFF",
        "CARTEST_ENABLE_STEERING": "OFF",
        "CARTEST_HARDWARE_ACCEPTED": "OFF",
        "CARTEST_RUNTIME_LOG_ENABLED": "ON",
        "CARTEST_FOLLOW_DIFF_PERMILLE": "0"
      }
    },
    {
      "name": "DebugFollow",
      "displayName": "DebugFollow - straight 500 permille; normal 600; hard 700; diff 0",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CARTEST_ENABLE_BENCH": "OFF",
        "CARTEST_ENABLE_FOLLOW": "ON",
        "CARTEST_ENABLE_STEERING": "OFF",
        "CARTEST_HARDWARE_ACCEPTED": "ON",
        "CARTEST_RUNTIME_LOG_ENABLED": "ON",
        "CARTEST_FOLLOW_DIFF_PERMILLE": "0"
      }
    },
    {
      "name": "DebugFollowNoLog",
      "displayName": "DebugFollowNoLog - straight 500 permille; normal 600; hard 700; diff 0; RAM log off",
      "inherits": "DebugFollow",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CARTEST_RUNTIME_LOG_ENABLED": "OFF"
      }
    },
    {
      "name": "DebugFollowDiff5",
      "displayName": "DebugFollowDiff5 - motors enabled; d=50 permille; PE7 toggle; 70% hard cap",
      "inherits": "DebugFollow",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CARTEST_FOLLOW_DIFF_PERMILLE": "50"
      }
    },
    {
      "name": "DebugFollowDiff10",
      "displayName": "DebugFollowDiff10 - motors enabled; d=100 permille; PE7 toggle; 70% hard cap",
      "inherits": "DebugFollow",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CARTEST_FOLLOW_DIFF_PERMILLE": "100"
      }
    },
    {
      "name": "DebugFollowTurn",
      "displayName": "DebugFollowTurn - 70/30 turn target; servo 120us/20ms; motor 40 permille/10ms",
      "inherits": "DebugFollow",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CARTEST_ENABLE_FOLLOW_TURN": "ON",
        "CARTEST_FOLLOW_DIFF_PERMILLE": "200"
      }
    },
    {
      "name": "DebugFollowSpeedPI",
      "displayName": "DebugFollowSpeedPI - experimental independent encoder speed PI; target 2400 milli-RPS; RAM log ON",
      "inherits": "DebugFollowTurn",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CARTEST_ENABLE_FOLLOW_SPEED_PI": "ON",
        "CARTEST_RUNTIME_LOG_ENABLED": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "Debug", "configurePreset": "Debug" },
    { "name": "DebugSteering", "configurePreset": "DebugSteering" },
    { "name": "DebugBench", "configurePreset": "DebugBench" },
    { "name": "DebugFollow", "configurePreset": "DebugFollow" },
    { "name": "DebugFollowNoLog", "configurePreset": "DebugFollowNoLog" },
    { "name": "DebugFollowDiff5", "configurePreset": "DebugFollowDiff5" },
    { "name": "DebugFollowDiff10", "configurePreset": "DebugFollowDiff10" },
    { "name": "DebugFollowTurn", "configurePreset": "DebugFollowTurn" },
    { "name": "DebugFollowSpeedPI", "configurePreset": "DebugFollowSpeedPI" }
  ]
}
