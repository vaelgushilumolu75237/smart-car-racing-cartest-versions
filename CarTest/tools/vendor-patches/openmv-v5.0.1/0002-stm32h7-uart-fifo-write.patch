+#if defined(STM32H7)
+// Fill only while the H7 TX FIFO reports space. Never wait for transmission completion.
+size_t uart_tx_fifo_data(machine_uart_obj_t *self, const void *src_in,
+    size_t num_bytes, int *errcode) {
+    if (num_bytes == 0 || num_bytes > UART_TX_FIFO_SIZE ||
+        self == NULL || src_in == NULL) {
+        *errcode = MP_EINVAL;
+        return 0;
+    }
+
+    size_t num_tx = 0;
+    int error = 0;
+    USART_TypeDef *uart = NULL;
+    mp_uint_t atomic_state = MICROPY_BEGIN_ATOMIC_SECTION();
+    if (!self->is_enabled || self->uartx == NULL) {
+        error = MP_EINVAL;
+        goto cleanup;
+    }
+
+    uart = self->uartx;
+    uint32_t cr1 = uart->CR1;
+    if ((cr1 & (USART_CR1_UE | USART_CR1_TE | USART_CR1_FIFOEN)) !=
+            (USART_CR1_UE | USART_CR1_TE | USART_CR1_FIFOEN) ||
+        (cr1 & (USART_CR1_M0 | USART_CR1_M1 | USART_CR1_PCE)) != 0 ||
+        (cr1 & (USART_CR1_TXEIE_TXFNFIE | USART_CR1_TCIE)) != 0 ||
+        (uart->CR2 & USART_CR2_STOP) != 0 ||
+        (uart->CR3 & (USART_CR3_RTSE | USART_CR3_CTSE | USART_CR3_DMAT)) != 0) {
+        error = MP_EINVAL;
+        goto cleanup;
+    }
+
+    // TC is the all-clear condition: if any earlier byte is pending, accept none.
+    if ((uart->ISR & USART_ISR_TC) == 0) {
+        error = MP_EAGAIN;
+        goto cleanup;
+    }
+
+    const uint8_t *src = (const uint8_t *)src_in;
+    while (num_tx < num_bytes) {
+        if ((uart->ISR & USART_ISR_TXE_TXFNF) == 0) {
+            error = MP_EAGAIN;
+            goto cleanup;
+        }
+        uart->TDR = src[num_tx++];
+    }
+
+cleanup:
+    MICROPY_END_ATOMIC_SECTION(atomic_state);
+    *errcode = error;
+    return num_tx;
+}
+
+bool uart_fifo_txdone(machine_uart_obj_t *self) {
+    if (self == NULL || !self->is_enabled || self->uartx == NULL) {
+        return false;
+    }
+    uint32_t cr1 = self->uartx->CR1;
+    if ((cr1 & (USART_CR1_UE | USART_CR1_TE | USART_CR1_FIFOEN)) !=
+            (USART_CR1_UE | USART_CR1_TE | USART_CR1_FIFOEN)) {
+        return false;
+    }
+    return (self->uartx->ISR & USART_ISR_TC) != 0;
+}
+#endif
 
