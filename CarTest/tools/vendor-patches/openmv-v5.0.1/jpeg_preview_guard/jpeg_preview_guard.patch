+typedef struct jpeg_compress_cleanup_context {
+    image_t *dst;
+    uint8_t *mcu_row_buffer;
+    bool owned_dst;
+    bool discard_dst;
+    uint32_t original_dst_size;
+} jpeg_compress_cleanup_context_t;
+
+static bool jpeg_compress_abort(void *context) {
+    (void) context;
+    return HAL_JPEG_Abort(&JPEG_state.jpeg_descr) == HAL_OK;
+}
+
+static void jpeg_compress_unbind_callbacks(void *context) {
+    (void) context;
+    if (HAL_JPEG_UnRegisterDataReadyCallback(&JPEG_state.jpeg_descr) != HAL_OK) {
+        JPEG_state.jpeg_descr.DataReadyCallback = HAL_JPEG_DataReadyCallback;
+    }
+    if (HAL_JPEG_UnRegisterGetDataCallback(&JPEG_state.jpeg_descr) != HAL_OK) {
+        JPEG_state.jpeg_descr.GetDataCallback = HAL_JPEG_GetDataCallback;
+    }
+}
+
+static void jpeg_compress_release_buffers(void *context) {
+    jpeg_compress_cleanup_context_t *cleanup = context;
+
+    if (cleanup->mcu_row_buffer) {
+        uma_free(cleanup->mcu_row_buffer);
+        cleanup->mcu_row_buffer = NULL;
+    }
+
+    if (cleanup->discard_dst) {
+        if (cleanup->owned_dst && cleanup->dst->data) {
+            uma_free(cleanup->dst->data);
+            cleanup->dst->data = NULL;
+            cleanup->dst->size = 0;
+        } else if (!cleanup->owned_dst) {
+            cleanup->dst->size = cleanup->original_dst_size;
+        }
+    }
+}
+
+static bool jpeg_compress_cleanup(image_t *dst, uint8_t *mcu_row_buffer, bool owned_dst,
+                                  uint32_t original_dst_size, bool discard_dst) {
+    jpeg_compress_cleanup_context_t cleanup = {
+        .dst = dst,
+        .mcu_row_buffer = mcu_row_buffer,
+        .owned_dst = owned_dst,
+        .discard_dst = discard_dst,
+        .original_dst_size = original_dst_size,
+    };
+
+    bool stopped = jpeg_preview_guard_cleanup(&cleanup, jpeg_compress_abort,
+                                               jpeg_compress_unbind_callbacks,
+                                               jpeg_compress_release_buffers);
+    if (!stopped) {
+        // Keep DMA-referenced storage alive if HAL could not confirm that it stopped.
+        JPEG_state.compress_abort_failed = true;
+        JPEG_state.quarantined_mcu_row_buffer = mcu_row_buffer;
+        JPEG_state.quarantined_dst_buffer = dst->data;
+        if (owned_dst && dst->data) {
+            dst->data = NULL;
+            dst->size = 0;
+        } else if (!owned_dst) {
+            dst->size = original_dst_size;
+        }
+    }
+    return stopped;
+}
